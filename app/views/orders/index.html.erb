<meta name="payjp-public-key" content="<%= ENV['PAYJP_PUBLIC_KEY'] %>">
<%= render "shared/second-header" %>
<div class='transaction-contents'>
  <div class='transaction-main'>
    <p class='transaction-title-text'>購入内容の確認</p>
    <div class='buy-item-info'>
      <%= image_tag @item.image, class: 'buy-item-img' %>
      <div class='buy-item-right-content'>
        <p class='buy-item-text'><%= @item.name %></p>
        <div class='buy-item-price'>
          <span class='item-price-text'>¥<%= @item.price %></span>
          <span class='item-price-sub-text'><%= @item.shipping_fee.name %></span>
        </div>
      </div>
    </div>
    <div class='item-payment'>
      <p class='item-payment-title'>支払金額</p>
      <p class='item-payment-price'>¥<%= @item.price %></p>
    </div>
    <%= form_with model: @order_address, url: item_orders_path(@item), local: true, id: 'order-form' do |f| %>
      <%= render 'shared/error_messages', model: f.object %>
      <div class='credit-card-form'>
        <p class='info-input-haedline'>クレジットカード情報入力</p>
        <div id='card-element'>
          <div class='purchase-input-wrap'>
            <label>カード情報 <span class='form-any'>必須</span></label>
            <div id='card-number' class='purchase-input'></div>
          </div>
          <div class='purchase-input-wrap'>
            <label>有効期限 <span class='form-any'>必須</span></label>
            <div id='card-expiry' class='purchase-input'></div>
          </div>
          <div class='purchase-input-wrap'>
            <label>セキュリティコード <span class='form-any'>必須</span></label>
            <div id='card-cvc' class='purchase-input'></div>
          </div>
        </div>
        <div id='card-errors' role='alert'></div>
        <%= f.hidden_field :token, id: 'card-token' %>
      </div>
      <div class='shipping-address-form'>
        <p class='info-input-haedline'>配送先入力</p>
        <div class='purchase-input-wrap'>
          <label>郵便番号 <span class='form-any'>必須</span></label>
          <%= f.text_field :postal_code, placeholder: '例）123-4567', class: 'purchase-input' %>
        </div>
        <div class='purchase-input-wrap'>
          <label>都道府県 <span class='form-any'>必須</span></label>
          <%= f.collection_select :prefecture_id, Prefecture.all, :id, :name, {}, class: 'purchase-input' %>
        </div>
        <div class='purchase-input-wrap'>
          <label>市区町村 <span class='form-any'>必須</span></label>
          <%= f.text_field :city, placeholder: '例）大阪市北区', class: 'purchase-input' %>
        </div>
        <div class='purchase-input-wrap'>
          <label>番地 <span class='form-any'>必須</span></label>
          <%= f.text_field :addresses, placeholder: '例）青山1-1-1', class: 'purchase-input' %>
        </div>
        <div class='purchase-input-wrap'>
          <label>建物名 <span class='form-any'>任意</span></label>
          <%= f.text_field :building, placeholder: '例）東京ビル103号', class: 'purchase-input' %>
        </div>
        <div class='purchase-input-wrap'>
          <label>電話番号 <span class='form-any'>必須</span></label>
          <%= f.text_field :phone_number, placeholder: '例）09012345678', class: 'purchase-input' %>
        </div>
      </div>
      <div class='buy-btn'>
        <%= f.submit '購入', class: 'buy-red-btn' %>
      </div>
    <% end %>
  </div>
</div>
<%= render "shared/second-footer" %>
