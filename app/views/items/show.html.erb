<%= render "shared/header" %>
<div class='item-show'>
  <div class='item-box'>
    <h2 class='name'><%= @item.name %></h2>
    <%= image_tag @item.image, class: 'item-box-img' %>
    <div class='item-price-box'>
      <p class='item-price'>¥ <%= @item.price %></p>
      <p class='item-postage'><%= ShippingFee.find(@item.shipping_fee_id).name %></p>
    </div>
    <p><%= @item.description %></p>
    <% if user_signed_in? %>
      <% if current_user.id == @item.user_id %>
        <%= link_to '商品の編集', '#', class: 'item-red-btn' %>
        <%= link_to '削除', '#', class: 'item-destroy' %>
      <% else %>
        <%= link_to '購入画面に進む', '#', class: 'item-red-btn' %>
      <% end %>
    <% end %>
    <table class='detail-table'>
      <tr>
        <td class='detail-item'>出品者</td>
        <td class='detail-value'><%= @item.user.nickname %></td>
      </tr>
      <tr>
        <td class='detail-item'>カテゴリー</td>
        <td class='detail-value'><%= Category.find(@item.category_id).name %></td>
      </tr>
      <tr>
        <td class='detail-item'>商品の状態</td>
        <td class='detail-value'><%= Condition.find(@item.condition_id).name %></td>
      </tr>
      <tr>
        <td class='detail-item'>配送料の負担</td>
        <td class='detail-value'><%= ShippingFee.find(@item.shipping_fee_id).name %></td>
      </tr>
      <tr>
        <td class='detail-item'>発送元の地域</td>
        <td class='detail-value'><%= Prefecture.find(@item.prefecture_id).name %></td>
      </tr>
      <tr>
        <td class='detail-item'>発送までの日数</td>
        <td class='detail-value'><%= ShippingDay.find(@item.shipping_day_id).name %></td>
      </tr>
    </table>
    <div class='option'>
      <%= link_to '#', class: 'favorite-btn' do %>
        <%= image_tag 'star.png', class: 'favorite-star-icon' %>
        お気に入り 0
      <% end %>
      <%= link_to '#', class: 'report-btn' do %>
        <%= image_tag 'flag.png', class: 'report-flag-icon' %>
        不適切な商品の通報
      <% end %>
    </div>
  </div>
</div>
<%= render "shared/footer" %>